# ---------------------------------------------------------------- Supabase
# Project Settings → API. The URL and anon key are public (the browser uses them;
# row level security protects the data). The service role key is a secret:
# server only, never prefixed with VITE_.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ---------------------------------------------------------------- Heyzine
# heyzine.com/developers — API key lists flipbooks; client id converts PDFs.
HEYZINE_API_KEY="MY_HEYZINE_API_KEY"
HEYZINE_CLIENT_ID="MY_HEYZINE_CLIENT_ID"

# ---------------------------------------------------------------- Site
# Public URL once deployed (QPay calls back to it), e.g. https://setguul.barilga.mn
APP_URL=""

# ---------------------------------------------------------------- QPay merchant API v2
# Left unset, the server uses QPay's public sandbox and its published test
# merchant — no real money moves.
# QPAY_BASE_URL="https://merchant.qpay.mn/v2"
# QPAY_USERNAME=""
# QPAY_PASSWORD=""
# QPAY_INVOICE_CODE=""

# ---------------------------------------------------------------- SMS (login codes)
# Operator gateway from your Unitel / Mobicom / Skytel contract. Fill the URL
# from their API document using the placeholders {token} {from} {to} {text}.
# Test with: npm run sms:test -- 99112233
SMS_API_TOKEN=""
SMS_SENDER=""
SMS_GATEWAY_URL=""
SMS_GATEWAY_METHOD="GET"
# POST gateways only:
# SMS_GATEWAY_BODY={"to":"{to}","from":"{from}","text":"{text}"}
# SMS_GATEWAY_CONTENT_TYPE="application/json"
# SMS_GATEWAY_AUTH_HEADER="Bearer {token}"
# Optional text the gateway reply must contain to count as sent:
# SMS_GATEWAY_SUCCESS=""
# Supabase → Authentication → Hooks → Send SMS hook → secret (v1,whsec_...)
SUPABASE_SMS_HOOK_SECRET=""
